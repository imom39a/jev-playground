# Official TypeSafe SDKs read this variable automatically.
TYPESAFE_API_KEY=

# The local loader also accepts the legacy/project-specific name below.
# JEV_API_KEY=

# Required for the regular-LLM lane.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=ibm-granite/granite-4.2-8b

# The server also recognizes the existing local name `openouterkey`.

# Optional model override for the TypeSafe lane.
JEV_MODEL=jev-latest

# Optional local server port.
PORT=4173
